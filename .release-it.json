{
  "hooks": {
    "before:init": [
      "npm test",
      "npm run build:lib"
    ]
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true,
    "push": true
  },
  "github": {
    "release": false
  },
  "gitlab": {
    "release": false
  },
  "npm": {
    "publish": true,
    "publishArgs": [
      "--access",
      "public",
      "--tag",
      "beta"
    ]
  }
}
