{
  "name": "svg-text-editor",
  "version": "1.0.0-beta.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./vue": "./dist/vue.js",
    "./style.css": "./dist/svg-text-editor.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:demo && npm run build:lib",
    "build:demo": "vite build --outDir dist-playground",
    "build:lib": "vite build --config vite.lib.config.js",
    "preview": "vite preview --outDir dist-playground",
    "release:beta": "release-it 1.0.0-beta.1",
    "release:beta:dry": "release-it 1.0.0-beta.1 --dry-run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "svg",
    "text-editor",
    "rich-text",
    "vue",
    "vue3",
    "wysiwyg"
  ],
  "author": "",
  "license": "ISC",
  "description": "SVG rich text editor built with Vue and Vite",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.picserver.info:33322/formfabrik/svg-text-editor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^20.14.5",
    "release-it": "^20.2.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
